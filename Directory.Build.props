<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Guillaume Lecomte</Authors>
    <Company>Guillaume Lecomte</Company>
    <Copyright>Copyright (c) Guillaume Lecomte</Copyright>
    <RepositoryUrl>https://github.com/guillaume86/SqlProjectSync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/guillaume86/SqlProjectSync</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MinVer: derive Version/AssemblyVersion/FileVersion from the closest annotated git tag.
         Tags must be prefixed with 'v' (e.g. v0.1.0). Untagged builds get 0.0.0-alpha.0.<height>+<sha>. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Source Link: embed repo + commit metadata in PDBs so consumers can step into our source
         from a debugger. PublishRepositoryUrl exposes the URL in the package; EmbedUntrackedSources
         covers generated files (e.g. assembly-info) that aren't in the git index. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Set by CI; normalizes PDB paths so symbol/source validation passes. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

</Project>
